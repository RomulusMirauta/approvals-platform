# Copy to .env (gitignored) or export these before `npm run dev -w @approvals/api`.
PORT=3000
HOST=0.0.0.0
# Unset: PGlite (in-process Postgres) keeps its data in apps/api/.data/pglite.
# Set: any Postgres, e.g. Neon: postgres://user:password@host/db?sslmode=require
DATABASE_URL=
# Required (32+ characters), except with `npm run dev`, which uses a public dev secret. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
# true only behind a proxy that sets X-Forwarded-For (Vercel, a load balancer), so rate limits see real client IPs.
TRUST_PROXY=
