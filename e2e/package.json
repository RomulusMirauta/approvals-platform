{
  "name": "@approvals/e2e",
  "version": "0.2.0",
  "private": true,
  "description": "Playwright end-to-end tests for the approvals API and dashboard.",
  "type": "module",
  "scripts": {
    "e2e": "playwright test --project=chromium",
    "smoke": "playwright test --project=chromium --grep @smoke",
    "screenshots": "playwright test --project=screenshots",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@approvals/contracts": "^0.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "tsx": "^4.23.15"
  }
}
