# Copy to .env (or .env.production) and adjust. Vite reads these at build time.

# Base URL of the approvals API, without a trailing /v1, for example https://api.example.com.
# Leave it empty to call the API on the same origin: in development the Vite dev server proxies /v1
# to the local API. On different origins, set the API's CORS_ORIGIN to the dashboard's origin.
VITE_API_URL=
